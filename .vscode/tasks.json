{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/compilar.sh"
      ],
      "windows": {
        "command": "cmd.exe",
        "args": [
          "/d",
          "/c",
          "${workspaceFolder}\\scripts\\compilar.bat"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$javac"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "group": {
